{
  "schema_version": "1.0",
  "name": "stashit",
  "display_name": "StashIt",
  "description": "Легковесный плавающий карман (Drag-and-Drop Shelf) для Windows 10 & 11 на Rust и Tauri v2.",
  "version": "1.0.0",
  "author": "kobaltgit",
  "license": "MIT",
  "accent_color": "#38BDF8",
  "website": {
    "enabled": true,
    "type": "flutter_web",
    "github_pages_url": "https://kobaltgit.github.io/stashit/"
